import QmlProject

Project {
    mainFile: "qml/Main.qml"

    QmlFiles {
        directory: "qml"
    }

    Files {
        filter: "qmldir"
        directory: "qml"
    }

    Files {
        filter: "*.conf"
        files: ["qtquickcontrols2.conf"]
    }

    Environment {
        QT_QUICK_CONTROLS_CONF: "qtquickcontrols2.conf"
        QML_COMPAT_RESOLVE_URLS_ON_ASSIGNMENT: "1"
        QT_LOGGING_RULES: "qt.qml.connections=false"
        QT_ENABLE_HIGHDPI_SCALING: "0"
    }

    qt6Project: true
    qdsVersion: "4.8"
    quickVersion: "6.8"

    /* 继续用现有 CMakeLists.txt 编译，不让 Design Studio 重新生成工程 */
    enableCMakeGeneration: false
}
